# ---- API (apps/api)
# Runtime mode. Controls whether error logs include stack traces.
NODE_ENV=development
# Minimum log level: debug | info | warn | error.
LOG_LEVEL=info
# HTTP port for the Fastify server.
PORT=3001
# Bind interface. Use 0.0.0.0 to accept external connections.
HOST=0.0.0.0
# Allowed CORS origins, comma separated.
ALLOWED_ORIGINS="http://localhost:3000"
# JWT secret for signing access tokens (min 32 chars).
JWT_SECRET="dev-secret-change-in-production-at-least-32-chars"
# Optional cookie secret (defaults to JWT_SECRET if not set).
COOKIE_SECRET="dev-cookie-secret-change-in-production"

# ---- Redis (for rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# ---- Database (MySQL 8.4 via Docker)
# Credentials of the container administrator.
MYSQL_ROOT_PASSWORD=root
# Database created automatically on the first startup.
MYSQL_DATABASE=desafio
# Application user.
MYSQL_USER=desafio
MYSQL_PASSWORD=desafio
# Host the API connects to. Use `localhost` when the API runs outside Docker.
MYSQL_HOST=localhost
# Port exposed on the host. Change it if MySQL already runs on 3306.
MYSQL_PORT=3306
